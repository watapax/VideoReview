# Copia este archivo a ".env" y cambia los valores antes de correr en cualquier lugar
# que no sea tu propio computador.

# Contraseña para entrar a la app (solo la usas tú, el profesor).
TEACHER_PASSWORD=cambia-esta-clave

# Clave usada para firmar la cookie de sesión. Cualquier texto largo y aleatorio sirve.
SECRET_KEY=cambia-esta-clave-tambien-por-algo-largo-y-random

# Opcional: solo hace falta si vas a usar la pestaña "Videos" (subir/ver videos
# de los estudiantes). Se guardan en un bucket de Cloudflare R2 — sin esto
# configurado, la pestaña de Videos igual se ve pero avisa que no puedes subir
# nada todavía. Sácalos del dashboard de Cloudflare (R2 → tu bucket, y
# R2 → Manage API tokens para las credenciales).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
